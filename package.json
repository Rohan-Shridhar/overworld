{
  "name": "geopolitical-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Geopolitical Sandbox: a full-stack simulation platform for modelling statecraft decisions.",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "start": "npm run start --workspace server",
    "preview": "npm run preview --workspace client",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.9.10"
  }
}
